{
    "name": "motif",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev:web": "vite --host 127.0.0.1",
        "dev:nw": "wait-on http://127.0.0.1:5173 && nw .nw-dev",
        "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:nw\"",
        "format": "prettier --write src",
        "build": "tsc -b && vite build",
        "build:desktop": "npm run build && node scripts/package-desktop.mjs"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.60",
        "@ai-sdk/mcp": "^2.0.55",
        "@ai-sdk/openai": "^4.0.72",
        "@ai-sdk/openai-compatible": "^3.0.53",
        "@ai-sdk/provider": "^4.0.17",
        "@base-ui/react": "^1.8.0",
        "@fontsource-variable/raleway": "^5.3.0",
        "ai": "^7.0.109",
        "ai-sdk-ollama": "^4.3.0",
        "ai-sdk-provider-codex-cli": "^2.0.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.4.0",
        "lucide-react": "^1.47.0",
        "mammoth": "^1.12.3",
        "markdown-it": "^15.0.2",
        "pdfjs-dist": "^6.3.289",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router": "^8.4.0",
        "shadcn": "^4.21.0",
        "tesseract.js": "^7.0.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.5",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.13.6",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^10.0.5",
        "eslint": "^10.10.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
        "globals": "^17.12.0",
        "nw": "^0.116.0-sdk",
        "prettier": "^3.9.8",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.3.0",
        "wait-on": "^9.1.0"
    }
